{
  "packageManager": "pnpm@12.21.0",
  "name": "P-Stream",
  "version": "5.3.7",
  "private": true,
  "homepage": "https://github.com/xp-technologies-dev/p-stream",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pwa": "cross-env VITE_PWA_ENABLED=true vite build",
    "pnpm:devPreinstall": "test -n \"$GH_PAT\" && AUTH_HEADER=$(printf 'bruhwhyamisobad:%s' \"$GH_PAT\" | base64 | tr -d '\\n') && git config --global --replace-all 'url.https://github.com/.insteadOf' 'git+ssh://git@github.com/' && { git config --global --unset-all http.https://github.com/.extraheader 2>/dev/null || true; } && git config --global --replace-all 'http.https://github.com/bruhwhyamisobad/providers.git/.extraheader' \"AUTHORIZATION: basic $AUTH_HEADER\"",
    "update-and-build": "pnpm run update-providers && pnpm run build",
    "update-providers": "pnpm update @p-stream/providers",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "lint:report": "eslint --output-file eslint_report.json --format json src",
    "preinstall": "npx -y only-allow pnpm"
  },
  "browserslist": {
    "production": [
      "defaults",
      "chrome > 90"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
